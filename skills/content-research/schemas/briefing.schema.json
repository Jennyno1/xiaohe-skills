{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://me.xiaohemiao.cn/schemas/briefing.schema.json",
  "title": "每日内容研究简报·数据层",
  "description": "由 content-research 日报 Markdown 转换而来的结构化数据。站点只消费本文件（元数据/结论/链接），不存正文。",
  "type": "object",
  "required": ["date", "version", "points", "tracks", "github"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
    "points": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "string", "minLength": 6 },
      "description": "今日要点，恰好 3 条"
    },
    "tracks": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["key", "name", "news", "insights", "actions"],
        "properties": {
          "key": { "enum": ["ai_tech", "enterprise_ai", "content_creation"] },
          "emoji": { "type": "string" },
          "name": { "type": "string" },
          "news": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "insights": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "github": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["repo", "note"],
        "properties": {
          "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "stars": { "type": ["integer", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "consensus": { "$ref": "#/$defs/viewpoint" },
    "division": { "$ref": "#/$defs/viewpoint" },
    "reading": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": { "title": { "type": "string" }, "url": { "type": ["string", "null"] } }
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "items_count": { "type": "integer" },
        "list": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "viewpoint": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "quotes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
